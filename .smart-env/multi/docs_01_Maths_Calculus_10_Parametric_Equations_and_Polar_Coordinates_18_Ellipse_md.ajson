0.00282378,-0.04032084,-0.11104172,-0.01609867,-0.0420839,0.03081965,0.02678821,-0.02334488,-0.06180391,0.01652599,-0.03274354,-0.05054544,-0.02309986,0.108372,0.00796295,-0.01857244,-0.00003026,0.04430785,0.02276805,-0.01135506,0.02956512,-0.00494423,0.02084152,-0.00982493,0.10573785,0.01861324,-0.04458356,-0.01485303,0.00295895,0.01394569,0.05455631,-0.05034833,-0.00146961,0.00857414,-0.02900192,-0.01319615,-0.06891911,-0.0540332,0.01596404,0.03345429,-0.08892892,0.02008697,-0.06864247,0.00622622,-0.0884217,0.00929654,-0.01884175,0.02147692,-0.01390303,-0.01990087,0.08706468,-0.02749485,0.06197722,-0.00078612,-0.00661295,-0.00957724,0.01822054,-0.00173962,-0.02645319,0.10244657,-0.01669915,-0.00740922,-0.06395124,-0.0347637,-0.00652697,0.05066989,-0.040018,0.0260976,-0.0135044,-0.00172238,-0.06781649,-0.05532974,-0.08299652,-0.1587089,-0.03992565,0.0157425,-0.04571183,0.06834432,-0.08276619,0.0361612,0.06042292,-0.02498221,-0.00191741,0.07943112,-0.04327817,-0.05778211,0.00492099,-0.03900366,-0.02357076,-0.0336859,0.05392269,-0.05313146,0.00069679,-0.00916531,0.03052728,-0.08437928,0.04295958,-0.00973262,-0.04422504,0.15123464,0.01205446,0.00145224,-0.00807565,0.01198357,-0.04707479,0.00887167,0.03085968,-0.00654664,0.01225127,0.0041859,-0.05329032,-0.0261311,-0.03988918,-0.02173937,0.07251615,0.00031608,0.07421829,-0.06705449,-0.02080088,0.01575406,0.05020092,0.03646861,0.04688058,-0.00423347,-0.0337565,0.03041088,-0.00756283,0.06147062,-0.0021224,0.01323434,-0.00531331,0.0147712,0.02824405,-0.00673312,0.02258693,0.02250791,-0.03070042,0.05852867,0.08756376,-0.00285475,-0.03171913,0.00541689,-0.05909356,0.0347027,0.1236062,0.02844802,-0.05202474,0.02650764,-0.05466165,0.11779489,0.06295591,0.04776618,-0.062645,0.00622468,-0.0783528,0.00364701,0.03116256,0.02141901,-0.02471026,0.05318014,-0.04421709,-0.01196732,-0.04769353,0.02838742,0.0515013,-0.03654894,0.00994719,-0.00246585,-0.01796943,-0.27962229,0.04463651,0.02448547,0.00087021,-0.02583141,0.07295203,0.03489